{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Full Stack (Express + Vite SSR)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "NODE_ENV": "development"
      },
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "Vite Client Only",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:client"],
      "port": 5000,
      "autoPort": true
    }
  ]
}
